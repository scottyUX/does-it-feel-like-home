,0,0,0.1);}\n    .order h2{margin-top:0;color:#004d40;}\n    .order p{margin:10px 0;}\n    .total{font-size:1.2em;color:#e74c3c;margin-top:20px;}\n    .btn{background:#28a745;color:#fff;padding:12px 20px;border:none;border-radius:4px;cursor:pointer;margin-top:20px;}\n    footer{background:#222;color:#ccc;text-align:center;padding:15px 0;margin-top:40px;}\n    @media (max-width:768px){\n        .container{padding:10px;}\n    }\n</style>\n</head>\n<body>\n<div class=\"container\">\n<header>\n    <h1>订单确认</h1>\n    <nav>\n        <a href=\"index.html\">首页</a>\n        <a href=\"restaurants.html\">餐厅列表</a>\n        <a href=\"about.html\">关于我们</a>\n    </nav>\n</header>\n\n<section class=\"order\">\n    <h2>您的订单已生成</h2>\n    <p><strong>餐厅：</strong>味满园</p>\n    <p><strong>菜品：</strong>宫保鸡丁 ×1，水煮鱼片 ×1，红油抄手 ×2</p>\n    <p class=\"total\">总金额：¥132</p>\n    <p>备注：请在收到外卖后及时评价，感谢您的支持！</p>\n    <button class=\"btn\" onclick=\"window.location.href='index.html'\">返回首页</button>\n</section>\n\n<footer>\n    <p>© 2025 快送外卖 · 成都配送服务</p>\n    <p>联系电话：138-0011-2233</p>\n</footer>\n</div>\n</body>\n</html>\n===== FILE: about.html  ===== (duplicate, already defined)  =====\n(Note: The above file already satisfies the requirement; no additional file needed.)"
