px;text-decoration:none;font-weight:bold;}\nnav a:hover{text-decoration:underline;}\nmain{background:#fff;padding:20px;margin-top:20px;border:1px solid #ddd;}\nform{max-width:600px;margin:auto;}\nlabel{display:block;margin-top:10px;}\ninput, select{width:100%;padding:8px;margin-top:5px;border:1px solid #ccc;border-radius:4px;}\nbutton{margin-top:20px;background:#004d7a;color:#fff;padding:10px 15px;border:none;border-radius:4px;cursor:pointer;width:100%;}\nbutton:hover{background:#003366;}\nfooter{background:#f0f0f0;text-align:center;padding:10px;margin-top:30px;font-size:0.9em;color:#666;}\n@media(max-width:768px){\n  .container{max-width:100%;}\n}\n</style>\n</head>\n<body>\n<div class=\"container\">\n<header>\n<h1>预订表单</h1>\n</header>\n<nav>\n<a href=\"index.html\">首页</a>\n<a href=\"about.html\">关于我们</a>\n<a href=\"results.html\">目的地</a>\n<a href=\"hotel.html\">酒店</a>\n<a href=\"booking.html\">预订</a>\n</nav>\n<main>\n<form>\n<label for=\"name\">姓名</label>\n<input type=\"text\" id=\"name\" name=\"name\" placeholder=\"请输入您的姓名\" required>\n\n<label for=\"phone\">手机号码</label>\n<input type=\"text\" id=\"phone\" name=\"phone\" placeholder=\"请输入您的手机号\" required>\n\n<label for=\"checkin\">入住日期</label>\n<input type=\"date\" id=\"checkin\" name=\"checkin\" required>\n\n<label for=\"checkout\">离店日期</label>\n<input type=\"date\" id=\"checkout\" name=\"checkout\" required>\n\n<label for=\"room\">房型</label>\n<select id=\"room\" name=\"room\" required>\n<option value=\"\">请选择房型</option>\n<option value=\"标准间\">标准间</option>\n<option value=\"高级间\">高级间</option>\n<option value=\"套房\">套房</option>\n</select>\n\n<label for=\"guests\">入住人数</label>\n<input type=\"number\" id=\"guests\" name=\"guests\" min=\"1\" value=\"2\" required>\n\n<label for=\"notes\">备注（可选）</label>\n<textarea id=\"notes\" name=\"notes\" rows=\"3\" placeholder=\"特殊需求或注意事项\"></textarea>\n\n<button type=\"submit\">提交预订</button>\n</form>\n</main>\n<footer>\n© 2025 畅行旅行 旅游预订平台\n</footer>\n</div>\n</body>\n</html>\n```",
  "content": "===== FILE: index.html  =====\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<title>畅行旅行 - 旅游预订平台</title>\n<style>\nbody{font-family:Arial,sans-serif;margin:0;color:#333;background:#f9f9f9;}\n.container{max-width:1440px;margin:0 auto;padding:20px;}\nheader{background:#004d7a;color:#fff;padding:15px;text-align:center;}\nnav{margin-top:10px;}\nnav a{color:#fff;margin:0 15px;text-decoration:none;font-weight:bold;}\nnav a:hover{text-decoration:underline;}\nmain{background:#fff;padding:20px;margin-top:20px;border:1px solid #ddd;}\n.search-form{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;margin-bottom:20px;}\n.search-form input,.search-form button{padding:8px;}\n.search-form input{border:1px solid #ccc;border-radius:4px;}\n.search-form button{background:#004d7a;color:#fff;border:none;border-radius:4px;cursor:pointer;}\nfooter{background:#f0f0f0;text-align:center;padding:10px;margin-top:30px;font-size:0.9em;color:#666;}\n@media(max-width:768px){\n  nav a{display:block;margin:5px 0;}\n}\n</style>\n</head>\n<body>\n<div class=\"container\">\n<header>\n<h1>畅行旅行</h1>\n</header>\n<nav>\n<a href=\"index.html\">首页</a>\n<a href=\"about.html\">关于我们</a>\n<a href=\"results.html\">目的地</a>\n<a href=\"hotel.html\">酒店</a>\n<a href=\"booking.html\">预订</a>\n</nav>\n<main>\n<h1>欢迎使用畅行旅行</h1>\n<p>畅行旅行是专注于国内旅游的在线预订平台，帮助您轻松规划度假和周末出游行程。您可以在这里搜索目的地、选择日期、查看酒店价格，并直接完成预订。</p>\n<div class=\"search-form\">\n<form action=\"results.html\" method=\"get\">\n<input type=\"text\" name=\"destination\" placeholder=\"目的地\" required style=\"flex:1;\">\n<input type=\"date\" name=\"checkin\" placeholder=\"入住日期\" required style=\"flex:1;\">\n<input type=\"date\" name=\"checkout\" placeholder=\"离店日期\" required style=\"flex:1;\">\n<input type=\"number\" name=\"guests\" placeholder=\"人数\" min=\"1\" value=\"2\" style=\"flex:1;\">\n<button type=\"submit\">搜索</button>\n</form>\n</div>\n<p>在这里开始您的旅行规划，发现更多精彩目的地与特色住宿。</p>\n</main>\n<footer>\n© 2025 畅行旅行 旅游预订平台\n</footer>\n</div>\n</body>\n</html>\n===== FILE: about.html  =====\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<title>关于我们 - 畅行旅行</title>\n<style>\nbody{font-family:Arial,sans-serif;margin:0;color:#333;background:#f9f9f9;}\n.container{max-width:1440px;margin:0 auto;padding:20px;}\nheader{background:#004d7a;color:#fff;padding:15px;text-align:center;}\nnav{margin-top:10px;}\nnav a{color:#fff;margin:0 15px;text-decoration:none;font-weight:bold;}\nnav a:hover{text-decoration:underline;}\nmain{background:#fff;padding:20px;margin-top:20px;border:1px solid #ddd;}\nfooter{background:#f0f0f0;text-align:center;padding:10px;margin-top:30px;font-size:0.9em;color:#666;}\n@media(max-width:768px){\n  nav a{display:block;margin:5px 0;}\n}\n</style>\n</head>\n<body>\n<div class=\"container\">\n<header>\n<h1>关于我们</h1>\n</header>\n<nav>\n<a href=\"index.html\">首页</a>\n<a href=\"about.html\">关于我们</a>\n<a href=\"results.html\">目的地</a>\n<a href=\"hotel.html\">酒店</a>\n<a href=\"booking.html\">预订</a>\n</nav>\n<main>\n<h2>我们是谁</h2>\n<p>畅行旅行成立于2020年，致力于为国内旅游爱好者提供一站式的预订服务。我们汇聚全国各主要城市的优质酒店资源，提供实时价格、房型和优惠信息，让您的出行更便捷、更可靠。</p>\n<h2>我们的目标</h2>\n<p>帮助每位访客轻松规划一次说走就走的旅行，无论是家庭郊游、情侣短途还是商务出差，都能在这里找到合适的住宿与行程方案。</p>\n<h2>联系我们</h2>\n<p>客服热线：400-123-4567<br>\n邮箱：service@changxinglv.com</p>\n</main>\n<footer>\n© 2025 畅行旅行 旅游预订平台\n</footer>\n</div>\n</body>\n</html>\n===== FILE: results.html  =====\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<title>搜索结果 - 畅行旅行</title>\n<style>\nbody{font-family:Arial,sans-serif;margin:0;color:#333;background:#f9f9f9;}\n.container{max-width:1440px;margin:0 auto;padding:20px;}\nheader{background:#004d7a;color:#fff;padding:15px;text-align:center;}\nnav{margin-top:10px;}\nnav a{color:#fff;margin:0 15px;text-decoration:none;font-weight:bold;}\nnav a:hover{text-decoration:underline;}\nmain{background:#fff;padding:20px;margin-top:20px;border:1px solid #ddd;}\n.search-form{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;margin-bottom:20px;}\n.search-form input,.search-form button{padding:8px;}\n.search-form input{border:1px solid #ccc;border-radius:4px;}\nsearch-form button{background:#004d7a;color:#fff;border:none;border-radius:4px;cursor:pointer;}\n.result-list{display:flex;flex-wrap:wrap;gap:20px;margin-top:20px;}\n.result-item{background:#fff;padding:15px;border:1px solid #ddd;width:300px;flex:1 1 250px;}\n.result-item img{width:100%;height:auto;border-radius:4px;margin-bottom:10px;}\n.result-item h3{margin:0 0 5px;font-size:1.2em;}\n.result-item p{margin:0;font-size:0.9em;color:#666;}\n.result-item .price{font-weight:bold;color:#0066cc;margin-top:5px;}\n.result-item .btn{display:inline-block;margin-top:10px;padding:6px 10px;background:#004d7a;color:#fff;border-radius:4px;text-decoration:none;}\nfooter{background:#f0f0f0;text-align:center;padding:10px;margin-top:30px;font-size:0.9em;color:#666;}\n@media(max-width:768px){\n  .result-item{width:100%;}\n}\n</style>\n</head>\n<body>\n<div class=\"container\">\n<header>\n<h1>搜索结果</h1>\n</header>\n<nav>\n<a href=\"index.html\">首页</a>\n<a href=\"about.html\">关于我们</a>\n<a href=\"results.html\">目的地</a>\n<a href=\"hotel.html\">酒店</a>\n<a href=\"booking.html\">预订</a>\n</nav>\n<main>\n<form class=\"search-form\" action=\"results.html\" method=\"get\">\n<input type=\"text\" name=\"destination\" placeholder=\"目的地\" value=\"\">\n<input type=\"date\" name=\"checkin\" placeholder=\"入住日期\">\n<input type=\"date\" name=\"checkout\" placeholder=\"离店日期\">\n<input type=\"number\" name=\"guests\" placeholder=\"人数\" min=\"1\" value=\"2\">\n<button type=\"submit\">搜索</button>\n</form>\n<div class=\"result-list\">\n<div class=\"result-item\">\n<img src=\"beijing.jpg\" alt=\"北京王府大酒店\">\n<h3>北京王府大酒店</h3>\n<p>位于北京市中心，设施豪华，适合商务与休闲。</p>\n<div class=\"price\">¥1200/晚</div>\n<a href=\"booking.html\" class=\"btn\">预订</a>\n</div>\n<div class=\"result-item\">\n<img src=\"shanghai.jpg\" alt=\"上海浦东希尔顿\">\n<h3>上海浦东希尔顿</h3>\n<p>坐拥浦东商务区，景观优美，服务周到。</p>\n<div class=\"price\">¥1500/晚</div>\n<a href=\"booking.html\" class=\"btn\">预订</a>\n</div>\n<div class=\"result-item\">\n<img src=\"guangzhou.jpg\" alt=\"广州香雪大酒店\">\n<h3>广州香雪大酒店</h3>\n<p>位于广州核心商圈，购物便利，适合家庭出游。</p>\n<div class=\"price\">¥1100/晚</div>\n<a href=\"booking.html\" class=\"btn\">预订</a>\n</div>\n</div>\n</main>\n<footer>\n© 2025 畅行旅行 旅游预订平台\n</footer>\n</div>\n</body>\n</html>\n===== FILE: hotel.html  =====\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<title>北京王府大酒店 - 畅行旅行</title>\n<style>\nbody{font-family:Arial,sans-serif;margin:0;color:#333;background:#f9f9f9;}\n.container{max-width:1440px;margin:0 auto;padding:20px;}\nheader{background:#004d7a;color:#fff;padding:15px;text-align:center;}\nnav{margin-top:10px;}\nnav a{color:#fff;margin:0 15px;text-decoration:none;font-weight:bold;}\nnav a:hover{text-decoration:underline;}\nmain{background:#fff;padding:20px;margin-top:20px;border:1px solid #ddd;}\n.hotel-detail{display:flex;flex-wrap:wrap;gap:20px;}\n.hotel-info{flex:2 1 600px;}\n.hotel-info img{max-width:100%;height:auto;border-radius:4px;margin-bottom:15px;}\n.hotel-info h2{margin-top:0;font-size:1.8em;}\n.hotel-info p{color:#666;margin-bottom:10px;}\n.hotel-info .price{font-size:1.4em;color:#0066cc;margin:10px 0;}\n.hotel-info .book-btn{background:#004d7a;color:#fff;padding:10px 15px;border:none;border-radius:4px;cursor:pointer;font-size:1em;}\n.hotel-gallery{flex:1 1 300px;}\n.hotel-gallery img{width:100%;height:auto;border-radius:4px;margin-bottom:10px;}\nfooter{background:#f0f0f0;text-align:center;padding:10px;margin-top:30px;font-size:0.9em;color:#666;}\n@media(max-width:768px){\n  .hotel-detail{flex-direction:column;}\n}\n</style>\n</head>\n<body>\n<div class=\"container\">\n<header>\n<h1>北京王府大酒店</h1>\n</header>\n<nav>\n<a href=\"index.html\">首页</a>\n<a href=\"about.html\">关于我们</a>\n<a href=\"results.html\">目的地</a>\n<a href=\"hotel.html\">酒店</a>\n<a href=\"booking.html\">预订</a>\n</nav>\n<main class=\"hotel-detail\">\n<div class=\"hotel-info\">\n<img src=\"beijing.jpg\" alt=\"北京王府大酒店外观\">\n<h2>北京王府大酒店</h2>\n<p>这家五星级酒店坐落于北京历史文化街区，建筑风格融合古典与现代，提供豪华客房、全日制餐饮、健身中心和宴会厅。</p>\n<p>房间配备免费Wi‑Fi、液晶电视、独立浴室和舒适床品，部分套房设有私人露台。</p>\n<div class=\"price\">¥1200 / 晚</div>\n<button class=\"book-btn\" onclick=\"document.getElementById('bookingForm').style.display='block();\">立即预订</button>\n</div>\n<div class=\"hotel-gallery\">\n<img src=\"beijing1.jpg\" alt=\"客房图片\">\n<img src=\"beijing2.jpg\" alt=\"餐厅环境\">\n<img src=\"beijing3.jpg\" alt=\"健身房设施\">\n</div>\n</main>\n<footer>\n© 2025 畅行旅行 旅游预订平台\n</footer>\n\n<div id=\"bookingForm\" style=\"display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);justify-content:center;align-items:center;\">\n<div style=\"background:#fff;padding:20px;border:1px solid #ccc;border-radius:4px;max-width:400px;width:90%;\">\n<h3>预订表单</h3>\n<label>姓名：<input type=\"text\" name=\"name\" required style=\"width:100%;margin-top:5px;\"></label><br>\n<label>手机：<input type=\"text\" name=\"phone\" required style=\"width:100%;margin-top:5px;\"></label><br>\n<label>入住日期：<input type=\"date\" name=\"checkin\" required style=\"width:100%;margin-top:5px;\"></label><br>\n<label>离店日期：<input type=\"date\" name=\"checkout\" required style=\"width:100%;margin-top:5px;\"></label><br>\n<label>房型：<select name=\"room\" required style=\"width:100%;margin-top:5px;\">\n<option value=\"\">请选择</option>\n<option value=\"标准间\">标准间</option>\n<option value=\"高级间\">高级间</option>\n<option value=\"套房\">套房</option>\n</select></label><br>\n<label>人数：<input type=\"number\" name=\"guests\" min=\"1\" value=\"2\" style=\"width:100%;margin-top:5px;\"></label><br>\n<button style=\"background:#004d7a;color:#fff;padding:8px 12px;border:none;border-radius:4px;cursor:pointer;width:100%;\">提交预订</button>\n</div>\n</div>\n</div>\n</body>\n</html>\n===== FILE: booking.html  =====\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<title>预订表单 - 畅行旅行</title>\n<style>\nbody{font-family:Ari