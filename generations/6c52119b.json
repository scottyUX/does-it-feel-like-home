ex.html\">首页</a></li>\n            <li><a href=\"services.html\">服务项目</a></li>\n            <li><a href=\"team.html\">我们的团队</a></li>\n            <li><a href=\"appointment.html\">预约服务</a></li>\n        </ul>\n    </nav>\n    <section class=\"hero\">\n        <h1>焕新你的美丽</h1>\n    </section>\n\n    <section class=\"section\">\n        <h2>热门服务</h2>\n        <div class=\"services-preview\">\n            <div class=\"service-card\">\n                <img src=\"cut.jpg\" alt=\"剪发\">\n                <h3>专业剪发</h3>\n                <p>为您量身定制的时尚发型</p>\n                <a class=\"btn\" href=\"services.html#cut\">了解更多</a>\n            </div>\n            <div class=\"service-card\">\n                <img src=\"color.jpg\" alt=\"染发\">\n                <h3>染发护理</h3>\n                <p>持久亮彩，呵护发质</p>\n                <a class=\"btn\" href=\"services.html#color\">了解更多</a>\n            </div>\n            <div class=\"service-card\">\n                <img src=\"skin.jpg\" alt=\"护肤\">\n                <h3>面部护肤</h3>\n                <p>深层清洁，焕活光彩</p>\n                <a class=\"btn\" href=\"services.html#skin\">了解更多</a>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"section\">\n        <h2>关于我们</h2>\n        <p>悦容美发美容坐落于广州市中心，拥有多年行业经验的资深发型师和护肤顾问团队。我们坚持使用国际顶级品牌产品，提供剪发、染发、烫发、护肤等全方位美丽服务，帮助每一位顾客找到最适合自己的风格。</p>\n        <a class=\"btn\" href=\"team.html\">认识我们的团队</a>\n    </section>\n\n    <section class=\"section\">\n        <h2>立即预约</h2>\n        <p>想要体验专业的美发美容服务？请点击下方按钮进入预约页面，填写您的需求，我们将尽快为您安排合适的时间。</p>\n        <a class=\"btn\" href=\"appointment.html\">预约服务</a>\n    </section>\n\n    <footer class=\"footer\">\n        © 2026 悦容美发美容 · 广州市天河区体育东路88号 · 电话：020-1234-5678\n    </footer>\n</body>\n</html>\n```\n===== FILE: services.html =====\n```html\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>服务项目 - 悦容美发美容</title>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <style>\n        bod