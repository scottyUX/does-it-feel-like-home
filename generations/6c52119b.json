15px;font-weight:bold;}\n        input, select, textarea{width:100%;padding:8px;margin-top:5px;border:1px solid #ccc;border-radius:4px;font-size:14px;}\n        textarea{resize:vertical;height:80px;}\n        .btn{margin-top:20px;background:#6c2d6a;color:#fff;padding:12px;border:none;border-radius:4px;width:100%;font-size:16px;cursor:pointer;}\n        .btn:hover{background:#5a2555;}\n        .message{margin-top:15px;color:#c45ea5;display:none;}\n        .footer{background:#333;color:#fff;padding:20px;text-align:center;font-size:14px;margin-top:40px;}\n        @media (max-width:768px){\n            nav ul{flex-direction:column;}\n            nav li{margin:5px 0;}\n        }\n    </style>\n    <script>\n        function validateForm(event){\n            event.preventDefault();\n            const name=document.getElementById('name').value.trim();\n            const phone=document.getElementById('phone').value.trim();\n            const service=document.getElementById('service').value;\n            const date=document.getElementById('date').value;\n            const time=document.getElementById('time').value;\n            const msg=document.getElementById('msg');\n\n            if(!name||!phone||!service||!date||!time){\n                msg.textContent='请完整填写所有必填信息。';\n                msg.style.display='block';\n                return;\n            }\n            msg.textContent='感谢您的预约！我们将在24小时内与您确认。';\n            msg.style.display='block';\n            // 表单不实际提交\n        }\n    </script>\n</head>\n<body>\n    <header>\n        <h1>悦容美发美容</h1>\n    </header>\n    <nav>\n        <ul>\n            <li><a href=\"index.html\">首页</a></li>\n            <li><a href=\"services.html\">服务项目</a></li>\n            <li><a href=\"team.html\">我们的团队</a></li>\n            <li><a href=\"appointment.html\">预约服务</a></li>\n        </ul>\n    </nav>\n\n    <section class=\"section\">\n        <h2>在线预约</h2>\n        <form onsubmit=\"validateForm(event)\">\n            <label for=\"name\">姓名 *</label>\n            <input type=\"text\" id=\"name\" placeholder=\"请输入姓名\" required>\n\n            <label for=\"phone\">手机号 *</label>\n            <input type=\"tel\" id=\"phone\" placeholder=\"如：13800138000\" required pattern=\"1[3-9]\\d{9}\">\n\n            <label for=\"email\">电子邮箱</label>\n            <input type=\"email\" id=\"email\" placeholder=\"可选，便于接收确认邮件\">\n\n            <label for=\"service\">选择服务 *</label>\n            <select id=\"service\" required>\n                <option value=\"\">请选择服务</option>\n                <option value=\"cut\">剪发 / 烫发</option>\n                <option value=\"color\">染发</option>\n                <option value=\"skin\">面部护肤</option>\n                <option value=\"combo\">套餐（剪+染）</option>\n            </select>\n\n            <label for=\"date\">预约日期 *</label>\n            <input type=\"date\" id=\"date\" required>\n\n            <label for=\"time\">预约时间 *</label>\n            <select id=\"time\" required>\n                <option value=\"\">请选择时间段</option>\n                <option>09:00 - 10:00</option>\n                <option>10:30 - 11:30</option>\n                <option>12:00 - 13:00</option>\n                <option>13:30 - 14:30</option>\n                <option>15:00 - 16:00</option>\n                <option>16:30 - 17:30</option>\n                <option>18:00 - 19:00</option>\n            </select>\n\n            <label for=\"note\">备注（可选）</label>\n            <textarea id=\"note\" placeholder=\"例如：对染发颜色的偏好\"></textarea>\n\n            <button type=\"submit\" class=\"btn\">提交预约</button>\n            <div id=\"msg\" class=\"message\"></div>\n        </form>\n    </section>\n\n    <footer class=\"footer\">\n        © 2026 悦容美发美容 · 广州市天河区体育东路88号 · 电话：020-1234-5678\n    </footer>\n</body>\n</html>\n```",
