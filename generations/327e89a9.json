er-radius:8px;text-align:center;}\n        .member img{width:120px;height:120px;border-radius:50%;object-fit:cover;margin-bottom:15px;}\n        .member h3{margin:10px 0 5px;}\n        .member p{margin:5px 0;color:#555;}\n        footer{background:#2c3e50;color:#bbb;padding:20px 0;text-align:center;font-size:14px;}\n        @media(max-width:768px){\n            .member{width:80%;}\n        }\n    </style>\n</head>\n<body>\n<header>\n    <div class=\"container\">\n        <h1 style=\"margin:0;\">悦容美发美容</h1>\n        <nav>\n            <a href=\"index.html\">首页</a>\n            <a href=\"services.html\">服务项目</a>\n            <a href=\"team.html\">团队介绍</a>\n            <a href=\"appointment.html\">预约</a>\n        </nav>\n    </div>\n</header>\n\n<div class=\"section\">\n    <div class=\"container\">\n        <h2>我们的专业团队</h2>\n        <div class=\"team-grid\">\n            <div class=\"member\">\n                <img src=\"data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD...\" alt=\"张颖\">\n                <h3>张颖</h3>\n                <p>首席发型师（10年经验）</p>\n                <p>擅长欧美潮流造型、婚礼造型。</p>\n            </div>\n            <div class=\"member\">\n                <img src=\"data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD...\" alt=\"李强\">\n                <h3>李强</h3>\n                <p>资深染发师（8年经验）</p>\n                <p>精通全头染、渐变染、低敏染色。</p>\n            </div>\n            <div class=\"member\">\n                <img src=\"data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD...\" alt=\"王珊\">\n                <h3>王珊</h3>\n                <p>皮肤护理专家（5年经验）</p>\n                <p>专注深层清洁、光子嫩肤、抗衰老护理。</p>\n            </div>\n            <div class=\"member\">\n                <img src=\"data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD...\" alt=\"陈浩\">\n                <h3>陈浩</h3>\n                <p>美发助理（3年经验）</p>\n                <p>负责洗发、吹风、日常造型。</p>\n            </div>\n            <div class=\"member\">\n                <img src=\"data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD...\" alt=\"赵莉\">\n                <h3>赵莉</h3>\n                <p>前台顾问</p>\n                <p>提供预约、咨询、会员服务。</p>\n            </div>\n        </div>\n    </div>\n</div>\n\n<footer>\n    <div class=\"container\">\n        <p>广州天河区珠江新城中信广场B座 101室 | 电话: 020-1234 5678</p>\n        <p>© 2026 悦容美发美容 版权所有</p>\n    </div>\n</footer>\n</body>\n</html>\n\n===== FILE: appointment.html =====\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>悦容美发美容 - 预约</title>\n    <style>\n        body{font-family:Arial,sans-serif;margin:0;color:#333;background:#f9f9f9;}\n        header{background:#2c3e50;color:#fff;padding:20px 0;}\n        .container{max-width:800px;margin:auto;padding:0 20px;}\n        nav a{color:#fff;margin:0 15px;text-decoration:none;font-size:16px;}\n        nav a:hover{text-decoration:underline;}\n        .section{padding:60px 0;background:#fff;margin-top:20px;}\n        .section h2{font-size:32px;margin-bottom:30px;text-align:center;}\n        form{display:flex;flex-direction:column;}\n        label{margin-top:15px;font-weight:bold;}\n        input, select, textarea{padding:10px;font-size:16px;margin-top:5px;border:1px solid #ccc;border-radius:4px;}\n        textarea{resize:vertical;height:100px;}\n        .btn-group{margin-top:20px;display:flex;justify-content:center;}\n        button{background:#e74c3c;color:#fff;border:none;padding:12px 30px;font-size:16px;border-radius:5px;cursor:pointer;margin:0 10px;}\n        button:hover{background:#c0392b;}\n        .message{margin-top:20px;color:#27ae60;font-weight:bold;text-align:center;}\n        footer{background:#2c3e50;color:#bbb;padding:20px 0;text-align:center;font-size:14px;}\n        @media(max-width:600px){\n            input, select, textarea{font-size:14px;}\n        }\n    </style>\n    <script>\n        function validateForm(event){\n            event.preventDefault();\n            const name=document.getElementById('name').value.trim();\n            const phone=document.getElementById('phone').value.trim();\n            const date=document.getElementById('date').value;\n            const time=document.getElementById('time').value;\n            const service=document.getElementById('service').value;\n            if(!name||!phone||!date||!time||!service){\n                alert('请完整填写所有必填项。');\n                return;\n            }\n            const msg=document.getElementById('msg');\n            msg.textContent='预约已提交！我们的客服将在24小时内与您确认。';\n            // Reset form fields (optional)\n            // event.target.reset();\n        }\n    </script>\n</head>\n<body>\n<header>\n    <div class=\"container\">\n        <h1 style=\"margin:0;\">悦容美发美容</h1>\n        <nav>\n            <a href=\"index.html\">首页</a>\n            <a href=\"services.html\">服务项目</a>\n            <a href=\"team.html\">团队介绍</a>\n            <a href=\"appointment.html\">预约</a>\n        </nav>\n    </div>\n</header>\n\n<div class=\"section\">\n    <div class=\"container\">\n        <h2>在线预约</h2>\n        <form onsubmit=\"validateForm(event)\">\n            <label for=\"name\">姓名 *</label>\n            <input type=\"text\" id=\"name\" placeholder=\"请输入您的姓名\">\n\n            <label for=\"phone\">手机号码 *</label>\n            <input type=\"tel\" id=\"phone\" placeholder=\"如：13800138000\">\n\n            <label for=\"service\">选择服务 *</label>\n            <select id=\"service\">\n                <option value=\"\">请选择服务项目</option>\n                <option>女士剪发</option>\n                <option>男士剪发</option>\n                <option>全头染发（单色）</option>\n                <option>渐变染发（哑光）</option>\n                <option>头皮深层护理</option>\n                <option>基础护肤（清洁+保湿）</option>\n                <option>深层焕肤套餐</option>\n                <option>情侣套餐（剪发+护理）</option>\n            </select>\n\n            <label for=\"date\">预约日期 *</label>\n            <input type=\"date\" id=\"date\">\n\n            <label for=\"time\">预约时间 *</label>\n            <select id=\"time\">\n                <option value=\"\">请选择时间段</option>\n                <option>09:00 - 10:00</option>\n                <option>10:30 - 11:30</option>\n                <option>12:00 - 13:00</option>\n                <option>13:30 - 14:30</option>\n                <option>15:00 - 16:00</option>\n                <option>16:30 - 17:30</option>\n                <option>18:00 - 19:00</option>\n                <option>19:30 - 20:30</option>\n            </select>\n\n            <label for=\"notes\">备注（可选）</label>\n            <textarea id=\"notes\" placeholder=\"对发型、颜色或皮肤有特殊需求？\"></textarea>\n\n            <div class=\"btn-group\">\n                <button type=\"submit\">提交预约</button>\n                <button type=\"reset\">重置表单</button>\n            </div>\n            <div id=\"msg\" class=\"message\"></div>\n        </form>\n    </div>\n</div>\n\n<footer>\n    <div class=\"container\">\n        <p>广州天河区珠江新城中信广场B座 101室 | 电话: 020-1234 5678</p>\n        <p>© 2026 悦容美发美容 版权所有</p>\n    </div>\n</footer>\n</body>\n</html>",
